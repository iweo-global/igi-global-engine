def increment_analytic_metric(metric_key):
    """Safely increments localized structural event metrics."""
    try:
        with open(SANDBOX_FILE, "r") as f:
            data = json.load(f)
        if isinstance(data, dict):
            data[metric_key] = data.get(metric_key, 0) + 1
            with open(SANDBOX_FILE, "w") as f:
                json.dump(data, f)
    except Exception:
        pass

def create_developer_sandbox(developer_email):
    """Generates secure unique asset testing credentials valid for 30 cycles."""
    try:
        with open(SANDBOX_FILE, "r") as f:
            sandboxes = json.load(f)
            
        sandbox_id = f"SBX-{int(time.time())}"
        expiry_date = datetime.now() + timedelta(days=30)
        
        sandboxes[sandbox_id] = {
            "developer_email": developer_email,
            "created_at": datetime.now().isoformat(),
            "expires_at": expiry_date.isoformat(),
            "status": "ACTIVE",
            "test_runs_completed": 0,
            "last_calibration_status": "UNTESTED"
        }
        
        with open(SANDBOX_FILE, "w") as f:
            json.dump(sandboxes, f)
            
        return sandbox_id, expiry_date.isoformat()
    except Exception:
        return None, None

