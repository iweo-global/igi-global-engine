@app.route("/admin/metrics", methods=["GET"])
def render_admin_metrics():
    """Compiles analytic records and generates a clean operations dashboard."""
    try:
        with open(SANDBOX_FILE, "r") as f:
            sandboxes = json.load(f)
        with open(SUPPORT_FILE, "r") as f:
            tickets = json.load(f)
    except Exception:
        return jsonify({"error": "Failed to read system metric logs"}), 500

    total_tickets = len(tickets)
    open_tickets = sum(1 for t in tickets if t.get("status") == "OPEN")
    
    resolved_times = []
    user_frequency = {}
    
    for t in tickets:
        user = t.get("github_username", "unknown")
        user_frequency[user] = user_frequency.get(user, 0) + 1
        
        if t.get("status") == "RESOLVED" and "resolved_at" in t and "timestamp" in t:
            try:
                start = datetime.fromisoformat(t["timestamp"])
                end = datetime.fromisoformat(t["resolved_at"])
                resolved_times.append((end - start).total_seconds())
            except ValueError:
                continue

    avg_rec_time = (sum(resolved_times) / len(resolved_times)) / 60.0 if resolved_times else 0.0
    recurring_failures = sum(1 for u, count in user_frequency.items() if count > 2)

    html = f"""<!DOCTYPE html><html><head><style>{BASE_CSS}</style><title>IGI Admin Console</title></head><body><div class="container">"""
    html += f"""<h1>IGI Core Command & Telemetry Center</h1><p>Real-time analytics engine processing wide-area operational variables.</p>"""
    html += f"""<div class="grid"><div class="card">Open Support Incidents<div class="stat">{open_tickets} / {total_tickets}</div></div>"""
    html += f"""<div class="card">Mean Resolution Time<div class="stat">{avg_rec_time:.1f} min</div></div>"""
    html += f"""<div class="card">High-Friction Environments<div class="stat">{recurring_failures}</div></div></div>"""
    
    html += f"""<h3>Active Core Tickets Registry</h3>"""
    if not tickets:
        html += f"""<p style="padding:15px;background:#1e293b;border-radius:6px;color:#64748b;">Zero mechanical friction anomalies reported across active node lines.</p>"""
    else:

    html += f"<h3>Active Core Tickets Registry</h3>"
    
    if not tickets:
        html += f"<p style='padding:15px;background:#1e293b;border-radius:6px;color:#64748b;'>Zero mechanical friction anomalies reported across active node lines.</p>"
    else:
        for t in tickets:
            # Flawlessly map status configurations without collapsing text paths
            if t.get("status") == "OPEN":
                status_badge = f"<span class='badge badge-open'>OPEN</span>"
            else:
                status_badge = f"<span class='badge badge-resolved'>RESOLVED</span>"
            
            # Segmented html row components to prevent single-line file wrapping
            html += f"<div style='padding:12px;background:#0f172a;border-radius:6px;margin-bottom:10px;border-left:4px solid #38bdf8;'>"
            html += f"    {status_badge} <strong>{t.get('ticket_id')}</strong><br>"
            html += f"    <span style='color:#94a3b8;'>User:</span> {t.get('github_username')} | "
            html += f"    <span style='color:#94a3b8;'>Category:</span> {t.get('category')}<br>"
            html += f"    <small style='color:#64748b; display:block; margin-top:5px;'>{t.get('message')}</small>"
            html += f"</div>"
            
    html += f"<br><a href='/' class='btn'>Back to Dashboard</a></div></body></html>"
    return html

